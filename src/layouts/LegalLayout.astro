---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<BaseLayout title={`${title} · Ligia Naula`} description={description}>
  <article class="legal">
    <div class="container legal__inner">
      <a class="link legal__back" href="/">← Volver al inicio</a>
      <p class="legal__draft"><span class="tag tag--pending">Borrador jurídico · pendiente de revisión</span></p>
      <h1 class="legal__title">{title}</h1>
      <div class="legal__body"><slot /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal { padding-block: clamp(48px, 8vw, 96px); }
  .legal__inner { max-width: 820px; }
  .legal__draft { margin-top: 32px; }
  .legal__title { margin-top: 16px; font-size: clamp(2.5rem, 7vw, 4.5rem); text-transform: uppercase; }
  .legal__body { margin-top: 32px; display: grid; gap: 18px; }
  .legal__body :global(h2) { margin-top: 24px; font-size: 1.5rem; }
  .legal__body :global(ul) { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .legal__body :global(a) { color: var(--orange-ink); }
</style>
