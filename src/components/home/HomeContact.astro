---
import { Image } from 'astro:assets';
import { contact, photos } from '../../content/site';
import SocialLinks from '../SocialLinks.astro';
import Icon from '../Icon.astro';
---
<section id="contacto" class="h-contact" aria-labelledby="h-contact-title">
  <div class="container h-contact__grid">
    <div class="h-contact__copy" data-reveal>
      <span class="kicker">Contacto</span>
      <h2 class="h2" id="h-contact-title">{contact.home.title}</h2>
      <p class="h-contact__text">{contact.home.text}</p>
      <div class="h-contact__actions">
        <a class="btn" href={contact.home.cta.href}>
          {contact.home.cta.label} <Icon name="arrow-right" size={18} />
        </a>
        <SocialLinks />
      </div>
    </div>
    <div class="h-contact__media" data-reveal>
      <Image src={photos.hug.src} alt={photos.hug.alt} widths={[400, 700, 900]} sizes="(min-width: 1024px) 34vw, 100vw" class="h-contact__img" />
    </div>
  </div>
</section>

<style>
  .h-contact { background: radial-gradient(90% 80% at 0% 100%, #ff8a26 0%, transparent 60%), var(--orange); padding-block: clamp(64px, 9vw, 120px); overflow: hidden; }
  .h-contact__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .h-contact .kicker { color: var(--ink); }
  .h-contact .kicker::before { background: var(--ink); }
  .h-contact__text { margin-top: 20px; font-size: clamp(1.125rem, 1.6vw, 1.3125rem); max-width: 40ch; }
  .h-contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 32px; }
  .h-contact__actions .btn:hover { background: var(--white); border-color: var(--white); color: var(--ink); }
  .h-contact__actions :global(.social a:hover) { background: var(--ink); border-color: var(--ink); color: var(--orange); }
  .h-contact__media { border-radius: 24px; overflow: hidden; border: 6px solid var(--white); aspect-ratio: 4 / 4.6; transform: rotate(-2deg); box-shadow: 0 40px 80px -40px rgb(80 30 0 / 0.55); }
  .h-contact__img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  @media (max-width: 900px) {
    .h-contact__grid { grid-template-columns: 1fr; }
    .h-contact__media { max-width: 420px; aspect-ratio: 4 / 3.6; transform: none; }
  }
</style>
