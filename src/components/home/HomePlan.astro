---
import { plan } from '../../content/site';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
---
<section id="plan-de-gobierno" class="section h-plan" aria-labelledby="h-plan-title">
  <span class="h-plan__glow" aria-hidden="true"></span>
  <div class="container">
    <div class="h-plan__head">
      <SectionHeading kicker="Propuestas" title={plan.title} lead={plan.home.text} id="h-plan-title" tone="dark" />
      <a class="btn btn--orange" href={plan.home.cta.href} data-reveal>
        {plan.home.cta.label} <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <ol class="axes">
      {plan.axes.map((axis, i) => (
        <li class="axis" data-reveal style={`--delay:${i * 70}ms`}>
          <span class="axis__num">{axis.num}</span>
          <h3 class="axis__title">{axis.title}</h3>
          <p class="axis__summary">{axis.summary}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .h-plan { position: relative; overflow: hidden; background: var(--ink); color: var(--white); }
  .h-plan__glow { position: absolute; top: -30%; right: -10%; width: 60vw; height: 60vw; max-width: 820px; max-height: 820px; border-radius: 50%; background: radial-gradient(circle, rgb(255 116 0 / 0.28), transparent 65%); pointer-events: none; }
  .h-plan .container { position: relative; }
  .h-plan__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .h-plan__head .btn:hover { background: var(--white); border-color: var(--white); }
  .axes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; list-style: none; margin: clamp(48px, 6vw, 72px) 0 0; padding: 0; }
  .axis { display: flex; flex-direction: column; gap: 14px; padding: 28px 26px; border-radius: var(--radius); background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.12); transition: border-color 250ms var(--ease), transform 250ms var(--ease); }
  .axis:hover { border-color: var(--orange); transform: translateY(-4px); }
  .axis__num { font-family: var(--font-display); font-size: 2.5rem; line-height: 1; color: var(--orange); }
  .axis__title { font-size: 1.5rem; line-height: 1.05; }
  .axis__summary { color: #cfcfcf; font-size: 0.9375rem; }
  @media (max-width: 1023px) { .axes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .axes { grid-template-columns: 1fr; } }
</style>
