---
import { Image } from 'astro:assets';
import { about, photos, status, timeline } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import SourceLink from './SourceLink.astro';
import DetailDialog from './DetailDialog.astro';
import Icon from './Icon.astro';

// En producción (draft = false) se ocultan los campos sin dato aprobado.
const bioFields = about.bioFields.filter((f) => f.value || status.draft);
---
<section id="conoce-a-ligia" class="section about" aria-labelledby="about-title">
  <div class="container">
    <div class="about__grid">
      <div class="about__media" data-reveal>
        <div class="about__photo">
          <Image
            src={photos.portrait.src}
            alt={photos.portrait.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="about__img"
          />
        </div>
        <span class="about__block" aria-hidden="true"></span>
      </div>

      <div class="about__copy">
        <SectionHeading kicker="Perfil" title={about.title} lead={about.lead} id="about-title" />

        <div class="about__text" data-reveal>
          {about.officialBiography
            ? <p set:html={about.officialBiography} />
            : <p>{about.provisionalText}</p>}
        </div>

        {bioFields.length > 0 && (
          <dl class="bio" data-reveal>
            {bioFields.map((f) => (
              <div class="bio__row">
                <dt>{f.label}</dt>
                <dd>
                  {f.value ?? (
                    <>
                      <span class="bio__pending">Información por confirmar</span>
                      <span class="tag tag--pending">Pendiente de aprobación</span>
                    </>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>

    <div class="tl">
      <div class="tl__head" data-reveal>
        <h3 class="tl__title">{about.timelineTitle}</h3>
        <p class="tl__note"><Icon name="info" size={18} /> {about.timelineNote}</p>
      </div>

      <ol class="tl__list">
        {timeline.map((item, i) => (
          <li class="tl__item" data-reveal style={`--delay:${i * 80}ms`}>
            <span class="tl__dot" aria-hidden="true"></span>
            <article class="tl__card">
              <p class="tl__year">{item.yearLabel}</p>
              <h4 class="tl__name">{item.title}</h4>
              <p class="tl__summary">{item.summary}</p>
              <div class="tl__foot">
                {!item.verified && <span class="tag tag--pending">Pendiente de verificación</span>}
                <button class="tl__more" type="button" data-dialog-open={`hito-${item.id}`}>
                  Ver fuentes y detalle <Icon name="arrow-right" size={16} />
                </button>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>

  {timeline.map((item) => (
    <DetailDialog id={`hito-${item.id}`} title={item.title} eyebrow={item.yearLabel}>
      <p>{item.summary}</p>
      {item.note && (
        <p class="detail__note"><Icon name="info" size={18} /> {item.note}</p>
      )}
      <div>
        <h4>Fuentes</h4>
        <ul class="detail__sources">
          {item.sources.map((s) => <li><SourceLink source={s} /></li>)}
        </ul>
      </div>
      {!item.verified && <p><span class="tag tag--pending">Pendiente de verificación editorial</span></p>}
    </DetailDialog>
  ))}
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: start;
  }
  .about__media { grid-column: 1 / span 5; position: relative; }
  .about__copy { grid-column: 7 / span 6; padding-top: 8px; }

  .about__photo {
    position: relative;
    z-index: 1;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .about__img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .about__block {
    position: absolute;
    right: -24px;
    bottom: -24px;
    width: 70%;
    height: 60%;
    border-radius: var(--radius);
    background: var(--orange);
  }

  .about__text { margin-top: 32px; font-size: 1.1875rem; max-width: 54ch; }

  .bio { margin: 36px 0 0; border-top: 1px solid var(--line); }
  .bio__row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 8px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .bio dt { font-family: var(--font-display); font-size: 1.0625rem; }
  .bio dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; color: var(--ink-soft); }
  .bio__pending { font-size: 0.9375rem; }

  /* Línea de tiempo */
  .tl { margin-top: clamp(80px, 10vw, 128px); }
  .tl__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 40px;
    margin-bottom: 48px;
  }
  .tl__title { font-size: clamp(1.75rem, 3.6vw, 2.75rem); text-transform: uppercase; }
  .tl__note { display: flex; gap: 8px; max-width: 44ch; color: var(--ink-soft); font-size: 0.9375rem; }
  .tl__note :global(svg) { flex-shrink: 0; margin-top: 3px; color: var(--orange-ink); }

  .tl__list { position: relative; list-style: none; margin: 0; padding: 0; }
  .tl__list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: linear-gradient(var(--orange), var(--gray));
    transform: translateX(-50%);
  }
  .tl__item { position: relative; display: grid; grid-template-columns: 1fr 1fr; padding-bottom: 32px; }
  .tl__item:nth-child(odd) .tl__card { grid-column: 1; margin-right: 56px; }
  .tl__item:nth-child(even) .tl__card { grid-column: 2; margin-left: 56px; }
  .tl__dot {
    position: absolute;
    top: 30px;
    left: 50%;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--white);
    border: 5px solid var(--orange);
    transform: translateX(-50%);
  }
  .tl__card {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    transition: transform 250ms var(--ease), box-shadow 250ms var(--ease);
  }
  .tl__card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .tl__year {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.875rem;
  }
  .tl__name { font-size: clamp(1.375rem, 2.4vw, 1.75rem); line-height: 1.1; margin-top: 16px; }
  .tl__summary { margin-top: 10px; color: var(--ink-soft); }
  .tl__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
  .tl__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--orange-ink);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .tl__more:hover { color: var(--ink); }
  .tl__more :global(svg) { transition: transform 200ms var(--ease); }
  .tl__more:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1023px) {
    .about__media { grid-column: 1 / span 12; max-width: 520px; }
    .about__copy { grid-column: 1 / span 12; }
  }
  @media (max-width: 767px) {
    .about__block { right: -12px; bottom: -12px; }
    .bio__row { grid-template-columns: 1fr; }
    .tl__list::before { left: 9px; transform: none; }
    .tl__item { grid-template-columns: 1fr; padding-left: 40px; }
    .tl__item:nth-child(n) .tl__card { grid-column: 1; margin: 0; }
    .tl__dot { left: 0; transform: none; }
    .tl__card { padding: 22px; }
  }
</style>
