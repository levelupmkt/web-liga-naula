---
import { plan, formatDate } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const approved = plan.approved;
---
<section id="plan-de-gobierno" class="section plan" aria-labelledby="plan-title">
  <span class="plan__glow" aria-hidden="true"></span>
  <div class="container">
    <div class="plan__head">
      <SectionHeading kicker="Documento" title={plan.title} lead={plan.lead} id="plan-title" tone="dark" />

      <div class="plan__status" data-reveal>
        {approved ? (
          <p class="plan__badge plan__badge--ok"><Icon name="check" size={16} /> Versión {approved.version} · {formatDate(approved.date)}</p>
        ) : (
          <p class="plan__badge"><Icon name="lock" size={16} /> {plan.statusLabel}</p>
        )}
        {!approved && <p class="plan__text">{plan.text}</p>}
        {approved ? (
          <a class="btn btn--orange" href={approved.pdfUrl} target="_blank" rel="noopener noreferrer" download>
            <Icon name="download" size={18} /> {plan.downloadLabel}
          </a>
        ) : (
          <div class="plan__download">
            <button class="btn" type="button" disabled aria-describedby="plan-download-note">
              <Icon name="download" size={18} /> {plan.downloadLabel}
            </button>
            <p id="plan-download-note" class="plan__hint">Disponible cuando exista una versión oficial aprobada.</p>
          </div>
        )}
      </div>
    </div>

    <ol class="axes">
      {approved
        ? approved.axes.map((axis, i) => (
            <li class="axis axis--ok" data-reveal style={`--delay:${i * 70}ms`}>
              <span class="axis__num">Eje {String(i + 1).padStart(2, '0')}</span>
              <h3 class="axis__title">{axis.title}</h3>
              <p class="axis__summary">{axis.summary}</p>
            </li>
          ))
        : plan.placeholderAxes.map((label, i) => (
            <li class="axis" data-reveal style={`--delay:${i * 70}ms`}>
              <span class="axis__num">{label}</span>
              <span class="axis__lines" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="axis__tag">Contenido por definir</span>
            </li>
          ))}
    </ol>
  </div>
</section>

<style>
  .plan {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
  }
  .plan__glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 116 0 / 0.28), transparent 65%);
    pointer-events: none;
  }
  .plan .container { position: relative; }
  .plan__head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px 64px;
    align-items: end;
  }
  .plan__status { display: grid; gap: 20px; justify-items: start; }
  .plan__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--ink);
    font-size: 0.875rem;
  }
  .plan__text { color: #d4d4d4; max-width: 50ch; }
  .plan__download { display: grid; gap: 8px; }
  .plan__hint { font-size: 0.875rem; color: #b5b5b5; }

  .axes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: clamp(48px, 7vw, 80px) 0 0;
    padding: 0;
  }
  .axis {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 260px;
    padding: 26px;
    border-radius: var(--radius);
    border: 1.5px dashed rgb(255 255 255 / 0.28);
    transition: border-color 250ms var(--ease), background-color 250ms var(--ease);
  }
  .axis:hover { border-color: var(--orange); background: rgb(255 255 255 / 0.03); }
  .axis__num { font-family: var(--font-display); font-size: 2.25rem; line-height: 1; color: var(--orange); }
  .axis__lines { display: grid; gap: 10px; margin-top: auto; }
  .axis__lines i { display: block; height: 10px; border-radius: 6px; background: rgb(255 255 255 / 0.1); }
  .axis__lines i:nth-child(2) { width: 82%; }
  .axis__lines i:nth-child(3) { width: 58%; }
  .axis__tag { font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; color: #bdbdbd; }
  .axis--ok { border-style: solid; }
  .axis__title { font-size: 1.5rem; }
  .axis__summary { color: #d4d4d4; }

  .plan :global(.btn:disabled) { --btn-bg: #2c2c2c; --btn-fg: #a8a8a8; border-color: #3a3a3a; }

  @media (max-width: 1023px) {
    .plan__head { grid-template-columns: 1fr; }
    .axes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .axes { grid-template-columns: 1fr; }
    .axis { min-height: 180px; }
  }
</style>
