---
import { Image } from 'astro:assets';
import { intro } from '../content/site';
import Icon from './Icon.astro';
---
<section class="intro" aria-labelledby="intro-title">
  <div class="container">
    <div class="intro__head" data-reveal>
      <h2 id="intro-title" class="intro__title">{intro.title}</h2>
      <p class="intro__text">{intro.text}</p>
    </div>
  </div>

  <ul class="tiles">
    {intro.cards.map((card, i) => (
      <li data-reveal style={`--delay:${i * 90}ms`}>
        <a class="tile" href={card.href}>
          <Image
            src={card.photo.src}
            alt=""
            widths={[480, 800, 1100]}
            sizes="(min-width: 768px) 34vw, 100vw"
            class="tile__img"
          />
          <span class="tile__shade" aria-hidden="true"></span>
          <span class="tile__num">{card.num}</span>
          <span class="tile__label">
            {card.label}
            <span class="tile__arrow"><Icon name="arrow-up-right" size={22} /></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .intro { padding-top: clamp(72px, 9vw, 120px); }
  .intro__head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .intro__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    text-transform: uppercase;
  }
  .intro__text { color: var(--ink-soft); font-size: 1.125rem; max-width: 42ch; }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 4.6;
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
  }
  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35);
    transition: transform 600ms var(--ease), filter 400ms var(--ease);
  }
  .tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 30%, rgb(0 0 0 / 0.72) 100%);
    transition: background-color 350ms var(--ease);
  }
  .tile:hover .tile__shade, .tile:focus-visible .tile__shade { background-color: rgb(255 116 0 / 0.55); }
  .tile:hover .tile__img, .tile:focus-visible .tile__img { transform: scale(1.05); filter: grayscale(0); }
  .tile__num {
    position: absolute;
    top: 24px;
    left: 24px;
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    padding: 6px 12px;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 999px;
  }
  .tile__label {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .tile__arrow {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--orange);
    color: var(--ink);
    transition: transform 300ms var(--ease), background-color 300ms var(--ease);
  }
  .tile:hover .tile__arrow { transform: rotate(45deg); background: var(--white); }
  .tile:focus-visible { outline-offset: -6px; outline-color: var(--white); }

  @media (max-width: 900px) {
    .intro__head { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .tiles { grid-template-columns: 1fr; }
    .tile { aspect-ratio: 16 / 10; }
  }
</style>
