---
import '../../styles/global.css';
import '../../styles/admin.css';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import { photos } from '../../content/site';
---
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso · Panel de campaña (demo)</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="login">
      <aside class="login__brand">
        <Image src={photos.group.src} alt="" widths={[600, 1000]} sizes="50vw" class="login__img" loading="eager" />
        <div class="login__shade" aria-hidden="true"></div>
        <div class="login__brand-copy">
          <span class="login__mark" aria-hidden="true">L</span>
          <p class="login__title">Panel de campaña</p>
          <p>Encuestas, mapa de calor y reportes de campo del equipo de Ligia Naula.</p>
        </div>
      </aside>

      <main class="login__main">
        <p class="login__demo"><Icon name="info" size={16} /> Prototipo de demostración · cualquier dato sirve</p>

        <form class="login__form" data-step="1" novalidate>
          <div class="login__head">
            <h1>Iniciar sesión</h1>
            <p class="muted">Acceso solo para el equipo autorizado.</p>
          </div>
          <div class="afield">
            <label for="l-email">Correo electrónico</label>
            <input class="ainput" id="l-email" type="email" autocomplete="username" value="andrea.molina@ejemplo.ec" required />
          </div>
          <div class="afield">
            <label for="l-pass">Contraseña</label>
            <input class="ainput" id="l-pass" type="password" autocomplete="current-password" value="demo-demo" required />
          </div>
          <button class="abtn abtn--primary login__submit" type="submit">Continuar <Icon name="arrow-right" size={18} /></button>
          <a class="small muted" href="#" data-forgot>¿Olvidaste tu contraseña?</a>
        </form>

        <form class="login__form" data-step="2" hidden novalidate>
          <div class="login__head">
            <span class="login__shield"><Icon name="shield" size={22} /></span>
            <h2>Verificación en dos pasos</h2>
            <p class="muted">Escribe el código de 6 dígitos de tu aplicación autenticadora.</p>
          </div>
          <fieldset class="otp">
            <legend class="sr-only">Código de verificación</legend>
            {Array.from({ length: 6 }, (_, i) => (
              <input class="ainput otp__digit" inputmode="numeric" maxlength="1" autocomplete={i === 0 ? 'one-time-code' : 'off'} aria-label={`Dígito ${i + 1}`} />
            ))}
          </fieldset>
          <p class="login__error" role="alert" data-error></p>
          <button class="abtn abtn--primary login__submit" type="submit">Verificar y entrar</button>
          <button class="abtn abtn--ghost" type="button" data-back><Icon name="arrow-left" size={16} /> Volver</button>
        </form>
      </main>
    </div>

    <script>
      const step1 = document.querySelector<HTMLFormElement>('[data-step="1"]')!;
      const step2 = document.querySelector<HTMLFormElement>('[data-step="2"]')!;
      const digits = Array.from(step2.querySelectorAll<HTMLInputElement>('.otp__digit'));
      const error = step2.querySelector<HTMLElement>('[data-error]')!;

      step1.addEventListener('submit', (e) => {
        e.preventDefault();
        step1.hidden = true;
        step2.hidden = false;
        digits[0].focus();
      });
      step2.querySelector('[data-back]')!.addEventListener('click', () => {
        step2.hidden = true;
        step1.hidden = false;
      });
      document.querySelector('[data-forgot]')!.addEventListener('click', (e) => {
        e.preventDefault();
        alert('Demo: aquí se enviaría un enlace de recuperación al correo.');
      });

      digits.forEach((d, i) => {
        d.addEventListener('input', () => {
          d.value = d.value.replace(/\D/g, '').slice(0, 1);
          if (d.value && digits[i + 1]) digits[i + 1].focus();
        });
        d.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !d.value && digits[i - 1]) digits[i - 1].focus();
        });
        d.addEventListener('paste', (e) => {
          const text = e.clipboardData?.getData('text').replace(/\D/g, '') ?? '';
          if (text.length > 1) {
            e.preventDefault();
            text.slice(0, 6).split('').forEach((c, k) => digits[k] && (digits[k].value = c));
            digits[Math.min(text.length, 5)].focus();
          }
        });
      });

      step2.addEventListener('submit', (e) => {
        e.preventDefault();
        const code = digits.map((d) => d.value).join('');
        if (code.length < 6) {
          error.textContent = 'Completa los 6 dígitos.';
          return;
        }
        error.textContent = '';
        window.location.href = '/admin';
      });
    </script>

    <style>
      .login { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 100dvh; }
      .login__brand { position: relative; isolation: isolate; display: flex; align-items: flex-end; padding: 48px; color: var(--white); overflow: hidden; }
      .login__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
      .login__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(255 116 0 / 0.25), rgb(22 22 22 / 0.9)); }
      .login__brand-copy { display: grid; gap: 12px; max-width: 420px; }
      .login__mark { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--orange); color: var(--ink); font-family: var(--font-display); font-size: 1.75rem; }
      .login__title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); line-height: 1; }

      .login__main { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 24px; padding: 48px 24px; background: var(--white); }
      .login__demo { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--orange-soft); color: var(--orange-ink); font-size: 0.8125rem; }
      .login__form { display: grid; gap: 18px; width: min(380px, 100%); }
      .login__form[hidden] { display: none; }
      .login__head { display: grid; gap: 8px; margin-bottom: 8px; }
      .login__head h1, .login__head h2 { font-size: 2rem; }
      .login__shield { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--orange-soft); color: var(--orange-ink); }
      .login__submit { min-height: 48px; }
      .otp { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin: 0; padding: 0; border: 0; }
      .otp__digit { min-height: 56px; text-align: center; font-family: var(--font-display); font-size: 1.5rem; padding: 0; }
      .login__error { color: #b91c1c; font-size: 0.875rem; min-height: 1.2em; }

      @media (max-width: 860px) {
        .login { grid-template-columns: minmax(0, 1fr); }
        .login__brand { min-height: 220px; padding: 28px; }
        .login__main { justify-content: flex-start; }
      }
    </style>
  </body>
</html>
