---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada · Ligia Naula">
  <section class="nf">
    <div class="container">
      <p class="nf__code">404</p>
      <h1 class="nf__title">Página no encontrada</h1>
      <p class="nf__text">La dirección que buscas no existe o ha cambiado.</p>
      <a class="btn" href="/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(72px, 12vw, 160px); background: var(--orange); }
  .nf__code { font-family: var(--font-display); font-size: clamp(6rem, 24vw, 16rem); line-height: 0.8; }
  .nf__title { margin-top: 16px; font-size: clamp(2rem, 5vw, 3.5rem); text-transform: uppercase; }
  .nf__text { margin: 12px 0 28px; }
</style>
